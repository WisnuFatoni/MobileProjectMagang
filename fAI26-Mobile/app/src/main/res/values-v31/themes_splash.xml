<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: splash bawaan sistem hanya berupa latar krem tanpa ikon, lalu animasi kita (SplashActivity) langsung mengambil alih. -->
    <style name="Theme.FAI26.Splash" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_latar</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/splash_latar</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_kosong</item>
    </style>
</resources>
