<?xml version="1.0" encoding="utf-8"?>
<!-- Kepala hijau bersama: dipakai Beranda Panen (include) dan KepalaHijau.java (Home, Beranda IPD) supaya tampilannya identik. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_header"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="76dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtSalam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selamat pagi"
                android:textColor="@color/header_on_muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtNama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/outfit_semibold"
                android:maxLines="1"
                android:textColor="@color/header_on"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/txtPeranTanggal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/header_on_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/txtAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar"
                android:fontFamily="@font/outfit_semibold"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textColor="?attr/colorPrimary"
                android:textSize="17sp" />

            <ImageView
                android:id="@+id/imgAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Foto profil"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Status koneksi: pil transparan seperti kolom pencarian; ketuk untuk menyegarkan -->
    <LinearLayout
        android:id="@+id/pillStatusKoneksi"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_field_header"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/dotStatus"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/ic_wifi_online"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/txtStatusKoneksi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Online • Terhubung ke Server"
            android:textColor="@color/header_on"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/btnSegarkanHeader"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center_vertical"
            android:minWidth="48dp"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_segarkan"
                app:tint="@color/header_on"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/txtSegarkanHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/outfit_medium"
                android:text="Segarkan"
                android:textColor="@color/header_on"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
