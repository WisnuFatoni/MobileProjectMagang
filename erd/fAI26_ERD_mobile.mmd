        TEXT diubah_pada "waktu UTC perubahan terakhir"
        INTEGER diubah_oleh "user_id pengubah terakhir"
        TEXT dihapus_pada "terisi bila dihapus lunak"
        INTEGER dihapus_oleh "user_id penghapus"
    }
    panen_header {
        TEXT panen_id PK "dibuat di HP"
        INTEGER unit_id FK
        INTEGER blok_id FK
        INTEGER tph_id FK
        INTEGER user_id FK "krani pencatat"
        TEXT device_id FK
        INTEGER model_id FK
        INTEGER periode_id FK
        TEXT tanggal_panen "YYYY-MM-DD"
        INTEGER rotasi_no
        INTEGER kondisi_cuaca
        REAL brondolan_kg
        REAL gps_lat
        REAL gps_lon
        REAL gps_akurasi_m
        TEXT gps_waktu
        INTEGER gps_mock
        REAL jarak_ke_tph_m
        TEXT status_lokasi
        TEXT catatan
        TEXT status
        TEXT dikirim_pada
        TEXT pesan_server "alasan bila ditolak"
        INTEGER disetujui_oleh "user_id mandor yang menyetujui"
        TEXT disetujui_pada "waktu UTC persetujuan mandor"
        TEXT dibuat_pada "waktu UTC saat baris dibuat"
        INTEGER dibuat_oleh "user_id pembuat, NULL untuk data awal sistem"
        TEXT diubah_pada "waktu UTC perubahan terakhir"
        INTEGER diubah_oleh "user_id pengubah terakhir"
        TEXT dihapus_pada "terisi bila dihapus lunak"
        INTEGER dihapus_oleh "user_id penghapus"
    }
    panen_pemanen {
        INTEGER pp_id PK
        TEXT panen_id FK
        INTEGER pemanen_id FK "boleh kosong"
        INTEGER jjg_alokasi
        TEXT catatan
        TEXT dibuat_pada "waktu UTC saat baris dibuat"
        INTEGER dibuat_oleh "user_id pembuat, NULL untuk data awal sistem"
        TEXT diubah_pada "waktu UTC perubahan terakhir"
        INTEGER diubah_oleh "user_id pengubah terakhir"
        TEXT dihapus_pada "terisi bila dihapus lunak"
        INTEGER dihapus_oleh "user_id penghapus"
    }
    panen_grading {
        INTEGER grading_id PK
        TEXT panen_id FK
        INTEGER kelas_id FK
        INTEGER jml_ai "hasil hitung kamera"
        INTEGER jml_final "setelah koreksi krani"
        INTEGER diubah_manual
        TEXT dibuat_pada "waktu UTC saat baris dibuat"
        INTEGER dibuat_oleh "user_id pembuat, NULL untuk data awal sistem"
        TEXT diubah_pada "waktu UTC perubahan terakhir"
        INTEGER diubah_oleh "user_id pengubah terakhir"
        TEXT dihapus_pada "terisi bila dihapus lunak"
        INTEGER dihapus_oleh "user_id penghapus"
    }
    foto {
        TEXT foto_id PK
        TEXT panen_id FK
        TEXT jenis
        TEXT path_lokal
        TEXT sha256
        INTEGER lebar
        INTEGER tinggi
        TEXT status_unggah
        TEXT dibuat_pada "waktu UTC saat baris dibuat"
        INTEGER dibuat_oleh "user_id pembuat, NULL untuk data awal sistem"
        TEXT diubah_pada "waktu UTC perubahan terakhir"
        INTEGER diubah_oleh "user_id pengubah terakhir"
        TEXT dihapus_pada "terisi bila dihapus lunak"
        INTEGER dihapus_oleh "user_id penghapus"
    }
    deteksi {
        INTEGER deteksi_id PK
        TEXT foto_id FK
        INTEGER kelas_id FK
        REAL confidence
        REAL x
        REAL y
        REAL w
        REAL h
        TEXT dibuat_pada "waktu UTC saat baris dibuat"
        INTEGER dibuat_oleh "user_id pembuat, NULL untuk data awal sistem"
        TEXT diubah_pada "waktu UTC perubahan terakhir"
        INTEGER diubah_oleh "user_id pengubah terakhir"
    }
    audit_log {
        TEXT audit_id PK
        TEXT tabel
        TEXT baris_id
        TEXT aksi "BUAT, UBAH, HAPUS, LOGIN, LOGIN_GAGAL, LOGOUT, KIRIM, TERIMA, TOLAK, IMPOR"
        TEXT nilai_lama "hanya kolom yang berubah"
        TEXT nilai_baru
        INTEGER user_id
        TEXT username "nama yang dicoba, berguna untuk LOGIN_GAGAL"
        TEXT device_id
        TEXT waktu "waktu UTC kejadian di HP atau server"
        INTEGER disinkron
        TEXT keterangan
    }
    sync_queue {
        INTEGER queue_id PK
        TEXT panen_id FK
        TEXT entitas
        TEXT aksi
        TEXT payload_json
        INTEGER percobaan
        TEXT status
        TEXT error_terakhir
        TEXT coba_terakhir
        TEXT dibuat_pada "waktu UTC saat baris dibuat"
        INTEGER dibuat_oleh "user_id pembuat, NULL untuk data awal sistem"
        TEXT diubah_pada "waktu UTC perubahan terakhir"
        INTEGER diubah_oleh "user_id pengubah terakhir"
    }
    master_sync {
        TEXT nama_master PK "blok, tph, pemanen, role, dst"
        INTEGER unit_id PK, FK
        TEXT versi_server
        TEXT sinkron_terakhir
        TEXT dibuat_pada "waktu UTC saat baris dibuat"
        INTEGER dibuat_oleh "user_id pembuat, NULL untuk data awal sistem"
        TEXT diubah_pada "waktu UTC perubahan terakhir"
        INTEGER diubah_oleh "user_id pengubah terakhir"
    }

    kode_temuan {
        INTEGER kode_id PK
        TEXT kode UK "A G S M1 M2 M3 M4 B1 B2 C R"
        TEXT nama
        TEXT kelompok "BUAH, BRONDOLAN, PELEPAH"
        INTEGER urut
        INTEGER aktif
        TEXT dibuat_pada "waktu UTC saat baris dibuat"
        INTEGER dibuat_oleh "user_id pembuat"
        TEXT diubah_pada
        INTEGER diubah_oleh
        TEXT dihapus_pada "hapus lunak"
        INTEGER dihapus_oleh
    }
    ipd_header {
        TEXT ipd_id PK "UUID dibuat di HP"
        INTEGER unit_id FK
        INTEGER blok_id FK
        INTEGER pemanen_id FK "satu catatan = satu pemanen"
        INTEGER user_id FK "yang menginspeksi"
        TEXT device_id FK
        TEXT tanggal_inspeksi "YYYY-MM-DD"
        TEXT ancak_no
        INTEGER divisi_id FK "Divisi 1 atau 2, dipilih di awal"
        INTEGER asisten_user_id FK "terisi otomatis dari divisi"
        INTEGER mandor_user_id FK "kemandoran: dipilih dari akun berperan MANDOR"
        INTEGER mandor_hrmb "salinan kode HRMB"
        TEXT catatan
        TEXT status "DRAFT, MENUNGGU_SETUJU, DISETUJUI, DITOLAK"
        TEXT dikirim_pada
        TEXT pesan_server "alasan ditolak asisten atau pesan terkunci"
        INTEGER divalidasi_oleh "inspektur, otomatis saat kirim"
        TEXT divalidasi_pada
        INTEGER disetujui_oleh "asisten"
        TEXT disetujui_pada
        INTEGER kirim_ulang "1 = diubah atau diperbaiki lalu dikirim ulang"
        TEXT dibuat_pada "waktu UTC saat baris dibuat"
        INTEGER dibuat_oleh "user_id pembuat"
        TEXT diubah_pada
        INTEGER diubah_oleh
        TEXT dihapus_pada "hapus lunak"
        INTEGER dihapus_oleh
    }
    ipd_pokok {
        INTEGER pokok_id PK
        TEXT ipd_id FK
        INTEGER no_baris "nomor baris pohon"
        INTEGER no_pokok "UNIQUE bersama ipd_id dan no_baris"
        TEXT dibuat_pada "waktu UTC saat baris dibuat"
        INTEGER dibuat_oleh "user_id pembuat"
        TEXT diubah_pada
        INTEGER diubah_oleh
        TEXT dihapus_pada "hapus lunak"
        INTEGER dihapus_oleh
    }
    ipd_temuan {
        INTEGER temuan_id PK
        INTEGER pokok_id FK
        INTEGER kode_id FK
        INTEGER jumlah "bawaan 1"
        TEXT catatan
        TEXT dibuat_pada "waktu UTC saat baris dibuat"
        INTEGER dibuat_oleh "user_id pembuat"
        TEXT diubah_pada
        INTEGER diubah_oleh
        TEXT dihapus_pada "hapus lunak"
        INTEGER dihapus_oleh
    }
    ipd_foto {
        TEXT foto_id PK
        TEXT ipd_id FK
        TEXT keterangan "boleh lebih dari satu foto per inspeksi"
        INTEGER urut
        TEXT path_lokal "NULL setelah terkirim, berkas HP dihapus"
        TEXT sha256
        INTEGER lebar
        INTEGER tinggi
        INTEGER ukuran_byte "setelah dikompres"
        TEXT status_unggah
        TEXT dibuat_pada "waktu UTC saat baris dibuat"
        INTEGER dibuat_oleh "user_id pembuat"
        TEXT diubah_pada
        INTEGER diubah_oleh
        TEXT dihapus_pada "hapus lunak"
        INTEGER dihapus_oleh
    }
