# Salin menjadi .env lalu isi. Jangan commit .env.
DB_HOST=localhost
DB_PORT=1433
DB_NAME=fai26
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_CERT=false

# Acak, minimal 32 karakter
FAI26_JWT_SECRET=
FAI26_MEDIA_DIR=media
FAI26_ADDR=:8080

# Opsional: folder hasil build web admin (fai26-web/dist). Bila diisi, API menyajikan web dari alamat yang sama
# (/api/* ke API, selain itu ke web). Kosongkan bila web dilayani oleh reverse proxy.
FAI26_WEB_DIR=

# Batas laju per alamat IP (permintaan per menit; 0 = tanpa batas).
# Login dan refresh dibatasi ketat sebagai pelindung tebak password; satu kebun bisa berbagi satu IP untuk banyak HP,
# jadi bawaannya longgar (30 dan 600).
FAI26_BATAS_LOGIN=30
FAI26_BATAS_UMUM=600
# Isi true HANYA bila API berada di belakang reverse proxy sendiri yang menimpa X-Forwarded-For. Bila false, alamat
# klien diambil dari sambungan langsung.
FAI26_PERCAYAI_PROXY=false

